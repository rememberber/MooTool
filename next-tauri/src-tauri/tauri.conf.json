{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MooTool Next Tauri",
  "version": "0.1.0",
  "identifier": "com.rememberber.mootool.next.tauri",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MooTool Next Tauri",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Developer utilities powered by Tauri and Rust",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
