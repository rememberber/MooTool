{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tool-clipboard-image",
  "description": "Least-privilege native image clipboard access for image-aware product tools.",
  "webviews": ["tool-image", "tool-qrcode"],
  "permissions": [
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-write-image",
    "core:image:allow-new",
    "core:image:allow-rgba",
    "core:image:allow-size"
  ]
}
